#Puerto utilizado por el backend
PORT = 3000

#Entorno de ejecución 
#development, tet o produccion
NODE_ENV=development

#Direccion interna del microservicio de FastAPI
AI_API_URL=http://127.0.0.1:8000

#Origen autorizado para consumir el backend
#durante el desarrollo se permite cualquier origen
CORS_ORIGIN=*

# Conexión de ejemplo a PostgreSQL.
# Nunca colocar aquí la contraseña real.
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/reciclaje_inteligente?schema=public"

# Seguridad de autenticación
JWT_SECRET=colocar_aqui_una_clave_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h
# Clave utilizada por el dispositivo para confirmar depósitos
DEVICE_API_KEY=colocar_aqui_una_clave_de_al_menos_32_caracteres
# Broker MQTT y dispositivo físico
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_DEVICE_ID=bin-01